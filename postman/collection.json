            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{petId}},\n  \"name\": \"{{updatedPetName}}\",\n  \"status\": \"sold\"\n}"
            },
            "url": "{{baseUrl}}/pet"
          },
          "response": []
