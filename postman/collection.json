            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('updated payload is reflected', function () {",
                  "  var body = pm.response.json();",
                  "  pm.expect(String(body.id)).to.eql(pm.collectionVariables.get('petId'));",
                  "  pm.expect(body.name).to.eql(pm.collectionVariables.get('updatedPetName'));",
                  "  pm.expect(body.status).to.eql('sold');",
                  "});"
