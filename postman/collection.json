  "item": [
    {
      "name": "Smoke",
      "item": [
        {
          "name": "Get inventory",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('content-type is json', function () {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "",
                  "pm.test('response time is under 2000ms', function () {",
                  "  pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "",
                  "pm.test('inventory is an object with non-negative numeric values', function () {",
                  "  var body = pm.response.json();",
                  "  pm.expect(body).to.be.an('object');",
                  "  Object.keys(body).forEach(function (key) {",
                  "    pm.expect(body[key]).to.be.a('number');",
                  "    pm.expect(body[key]).to.be.at.least(0);",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/store/inventory"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Pet CRUD Flow",
      "item": [
        {
          "name": "Create pet",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var seed = Number(pm.collectionVariables.get('petIdSeed') || '910000');",
                  "var generatedId = seed + Math.floor(Math.random() * 100000);",
                  "pm.collectionVariables.set('petId', String(generatedId));",
                  "pm.collectionVariables.set('petName', 'qa-pet-' + generatedId);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200 or 201', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "pm.test('content-type is json', function () {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "",
                  "pm.test('created pet has expected schema and values', function () {",
                  "  var body = pm.response.json();",
                  "  pm.expect(body.id).to.be.a('number');",
                  "  pm.expect(String(body.id)).to.eql(pm.collectionVariables.get('petId'));",
                  "  pm.expect(body.name).to.eql(pm.collectionVariables.get('petName'));",
                  "  pm.expect(body.status).to.be.oneOf(['available', 'pending', 'sold']);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{petId}},\n  \"name\": \"{{petName}}\",\n  \"status\": \"available\"\n}"
            },
            "url": "{{baseUrl}}/pet"
          },
          "response": []
        },
        {
          "name": "Get created pet",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('content-type is json', function () {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "",
                  "pm.test('id, name and status are correct', function () {",
                  "  var body = pm.response.json();",
                  "  pm.expect(String(body.id)).to.eql(pm.collectionVariables.get('petId'));",
                  "  pm.expect(body.name).to.eql(pm.collectionVariables.get('petName'));",
                  "  pm.expect(body.status).to.be.oneOf(['available', 'pending', 'sold']);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/pet/{{petId}}"
          },
          "response": []
        },
        {
          "name": "Update pet",
