              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var edgeId = Number(pm.collectionVariables.get('petIdSeed') || '910000') + 200000 + Math.floor(Math.random() * 100000);",
                  "pm.collectionVariables.set('edgePetId', String(edgeId));",
                  "pm.collectionVariables.set('edgeLongName', 'edge-'.concat('x'.repeat(180)));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('long name pet creation succeeds', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "pm.test('long name is preserved', function () {",
                  "  var body = pm.response.json();",
                  "  pm.expect(String(body.id)).to.eql(pm.collectionVariables.get('edgePetId'));",
                  "  pm.expect(body.name.length).to.be.at.least(100);",
                  "});"
                ]
              }
            }
          ],
